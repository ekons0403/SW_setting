# ========================================
# SW_setting Git Ignore
# ========================================

# Log files
log/*
!log/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
.venv/
venv/
env/
ENV/

# Conda environments
.conda/
conda-env/

# Jupyter
.ipynb_checkpoints/

# IDE / Editor
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
